  <checks>
    <!-- 1: a 30-row table (375pt) 24pt down a 300pt body: rows 1 to 22 on page 1, nothing beside; the anchor beside rows 23 to 30 on page 2 -->
    <eval expected="18" xpath="count(//pageViewport)"/>
    <eval expected="1" xpath="count((//pageViewport)[1]//word[.='row22'])"/>
    <eval expected="0" xpath="count((//pageViewport)[1]//word[.='row23'])"/>
    <eval expected="0" xpath="count((//pageViewport)[1]//word[.='a1'])"/>
    <eval expected="0" xpath="count((//pageViewport)[1]//flow/block[@positioning='absolute' and @top-offset])"/>
    <eval expected="1" xpath="count((//pageViewport)[2]//word[.='row23'])"/>
    <eval expected="1" xpath="count((//pageViewport)[2]//word[.='row30'])"/>
    <eval expected="50000" xpath="(//pageViewport)[2]//word[.='a1']/ancestor::lineArea[1]/@ipd"/>
    <eval expected="50000" xpath="(//pageViewport)[2]//word[.='after']/ancestor::lineArea[1]/@ipd"/>
    <!-- 2: with a 12pt offset the first part is shifted 12pt below the flow's height, 36pt down, and holds 21 rows; the continuation opens its page at the top -->
    <eval expected="12000" xpath="(//pageViewport)[3]//flow/block[@positioning='absolute']/@top-offset"/>
    <eval expected="1" xpath="count((//pageViewport)[3]//word[.='row21'])"/>
    <eval expected="0" xpath="count((//pageViewport)[3]//word[.='row22'])"/>
    <eval expected="1" xpath="count((//pageViewport)[4]//word[.='row22'])"/>
    <eval expected="0" xpath="count((//pageViewport)[4]//flow/block[@positioning='absolute']/@top-offset)"/>
    <eval expected="50000" xpath="(//pageViewport)[4]//word[.='a2']/ancestor::lineArea[1]/@ipd"/>
    <!-- 3: a header row is repeated at the top of the continuation -->
    <eval expected="1" xpath="count((//pageViewport)[5]//word[.='HEAD'])"/>
    <eval expected="1" xpath="count((//pageViewport)[5]//word[.='row21'])"/>
    <eval expected="1" xpath="count((//pageViewport)[6]//word[.='HEAD'])"/>
    <eval expected="1" xpath="count((//pageViewport)[6]//word[.='row22'])"/>
    <!-- 4: the anchor opens the flow: the first part fills the page from its top, 24 rows -->
    <eval expected="1" xpath="count((//pageViewport)[7]//word[.='row24'])"/>
    <eval expected="0" xpath="count((//pageViewport)[7]//word[.='a4'])"/>
    <eval expected="1" xpath="count((//pageViewport)[8]//word[.='row25'])"/>
    <eval expected="50000" xpath="(//pageViewport)[8]//word[.='a4']/ancestor::lineArea[1]/@ipd"/>
    <!-- 5: 100 rows over five pages, nothing beside the first four parts, the anchor beside the last -->
    <eval expected="1" xpath="count((//pageViewport)[9]//word[.='row22'])"/>
    <eval expected="1" xpath="count((//pageViewport)[10]//word[.='row46'])"/>
    <eval expected="1" xpath="count((//pageViewport)[11]//word[.='row70'])"/>
    <eval expected="1" xpath="count((//pageViewport)[12]//word[.='row94'])"/>
    <eval expected="0" xpath="count((//pageViewport)[10]//lineArea[@ipd='50000'])"/>
    <eval expected="0" xpath="count((//pageViewport)[12]//lineArea[@ipd='50000'])"/>
    <eval expected="1" xpath="count((//pageViewport)[13]//word[.='row95'])"/>
    <eval expected="50000" xpath="(//pageViewport)[13]//word[.='a5']/ancestor::lineArea[1]/@ipd"/>
    <!-- 6: a row of thirty lines is split inside itself, as in the flow: 21 of them fit below row 1 -->
    <eval expected="1" xpath="count((//pageViewport)[14]//word[.='l21'])"/>
    <eval expected="0" xpath="count((//pageViewport)[14]//word[.='l22'])"/>
    <eval expected="1" xpath="count((//pageViewport)[15]//word[.='l22'])"/>
    <eval expected="1" xpath="count((//pageViewport)[15]//word[.='l30'])"/>
    <eval expected="1" xpath="count((//pageViewport)[15]//word[.='row3'])"/>
    <eval expected="50000" xpath="(//pageViewport)[15]//word[.='a6']/ancestor::lineArea[1]/@ipd"/>
    <!-- 7: a kept row of twenty lines that does not fit below row 1 moves whole to the continuation -->
    <eval expected="1" xpath="count((//pageViewport)[16]//word[.='row1'])"/>
    <eval expected="0" xpath="count((//pageViewport)[16]//word[.='l1'])"/>
    <eval expected="1" xpath="count((//pageViewport)[17]//word[.='l1'])"/>
    <eval expected="1" xpath="count((//pageViewport)[17]//word[.='l20'])"/>
    <!-- 8: a float that is no table is not split: taller than the page, it is drawn as before -->
    <eval expected="1" xpath="count((//pageViewport)[18]//word[.='PICTURE'])"/>
    <eval expected="50000" xpath="(//pageViewport)[18]//word[.='a8']/ancestor::lineArea[1]/@ipd"/>
