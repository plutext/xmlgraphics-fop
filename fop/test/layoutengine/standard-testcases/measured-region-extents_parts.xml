<testcase>
  <info>
    <p>
      Two parts of one page-sequence (page-master-by-content) whose masters have different headers, three lines
      and six: each master is measured on its own, and the page breaking uses each page's body height, the
      second part's pages holding 13 lines where the first part's hold 16.
    </p>
  </info>
  <fo>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:fox="http://xmlgraphics.apache.org/fop/extensions">
<fo:layout-master-set><fo:simple-page-master master-name="A" page-width="300pt" page-height="300pt" margin-top="20pt" margin-bottom="20pt" margin-left="10pt" margin-right="10pt"><fo:region-body margin-top="30pt" margin-bottom="30pt"/><fo:region-before extent="10pt" region-name="a-before" fox:extent="measured"/><fo:region-after extent="10pt" region-name="xsl-region-after" fox:extent="measured"/></fo:simple-page-master><fo:simple-page-master master-name="B" page-width="300pt" page-height="300pt" margin-top="20pt" margin-bottom="20pt" margin-left="10pt" margin-right="10pt"><fo:region-body margin-top="30pt" margin-bottom="30pt"/><fo:region-before extent="10pt" region-name="b-before" fox:extent="measured"/><fo:region-after extent="10pt" region-name="xsl-region-after" fox:extent="measured"/></fo:simple-page-master><fo:page-sequence-master master-name="psmA"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="A"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master><fo:page-sequence-master master-name="psmB"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="B"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master></fo:layout-master-set>
