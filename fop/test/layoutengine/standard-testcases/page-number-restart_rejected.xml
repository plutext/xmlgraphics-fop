<!-- $Id$ -->
<!-- Added by Plutext Pty Ltd for the docx4j FO renderer (docx4j-fo-renderer), a modified distribution derived
     from Apache FOP 2.11: a test of hook page-number-restart (fop/CR-017.2). -->
<testcase>
  <info>
    <p>
      Values of fox:page-number-restart and fox:page-number-restart-parity that cannot be honoured are reported by
      an event and ignored. First sequence: a restart that is not a whole number, so the count runs on (1, 2, 3).
      Second: a parity other than "keep", so the restart at 4 applies without it, on the page the part opens (4,
      5), continuing from the first sequence's last page.
    </p>
  </info>
  <fo>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:fox="http://xmlgraphics.apache.org/fop/extensions"><fo:layout-master-set><fo:simple-page-master master-name="A" page-width="300pt" page-height="200pt" margin-top="10pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body/></fo:simple-page-master><fo:page-sequence-master master-name="psmA"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="A"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master></fo:layout-master-set>
<fo:page-sequence master-reference="psmA"><fo:flow flow-name="xsl-region-body" font-size="10pt" line-height="12pt"><fo:block>cover</fo:block><fo:block break-before="page" fox:page-sequence-master-reference="psmA" fox:page-number-restart="five">p</fo:block><fo:block break-before="page">q</fo:block></fo:flow></fo:page-sequence>
<fo:page-sequence master-reference="psmA"><fo:flow flow-name="xsl-region-body" font-size="10pt" line-height="12pt"><fo:block>cover</fo:block><fo:block break-before="page" fox:page-sequence-master-reference="psmA" fox:page-number-restart="4" fox:page-number-restart-parity="odd">p</fo:block><fo:block break-before="page">q</fo:block></fo:flow></fo:page-sequence>
</fo:root>
  </fo>
  <checks>
    <eval expected="6" xpath="count(//pageViewport)"/>
    <eval expected="1" xpath="(//pageViewport)[1]/@formatted-nr"/>
    <eval expected="2" xpath="(//pageViewport)[2]/@formatted-nr"/>
    <eval expected="3" xpath="(//pageViewport)[3]/@formatted-nr"/>
    <eval expected="4" xpath="(//pageViewport)[4]/@formatted-nr"/>
    <eval expected="4" xpath="(//pageViewport)[5]/@formatted-nr"/>
    <eval expected="5" xpath="(//pageViewport)[6]/@formatted-nr"/>
  </checks>
  <event-checks>
    <event key="pageNumberRestartInvalid" value="five"/>
    <event key="pageNumberRestartParityInvalid" value="odd"/>
  </event-checks>
</testcase>
