<!-- Added by Plutext Pty Ltd for the docx4j FO renderer (docx4j-fo-renderer), a modified distribution derived
     from Apache FOP 2.11: a test of hook measured-region-extents (fop/CR-018). -->
<testcase>
  <info>
    <p>
      fox:extent="measured" on fo:region-after, three lines: the region is anchored at the page's foot, so its
      top edge moves up to 36pt above the foot of the page reference area, and the body ends above it.
    </p>
  </info>
  <fo>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:fox="http://xmlgraphics.apache.org/fop/extensions">
<fo:layout-master-set><fo:simple-page-master master-name="M" page-width="300pt" page-height="300pt" margin-top="20pt" margin-bottom="20pt" margin-left="10pt" margin-right="10pt"><fo:region-body margin-top="30pt" margin-bottom="30pt"/><fo:region-before extent="10pt" region-name="xsl-region-before" fox:extent="measured"/><fo:region-after extent="10pt" region-name="xsl-region-after" fox:extent="measured"/></fo:simple-page-master></fo:layout-master-set>
<fo:page-sequence master-reference="M"><fo:static-content flow-name="xsl-region-after" font-size="10pt" line-height="12pt"><fo:block>f1</fo:block><fo:block>f2</fo:block><fo:block>f3</fo:block></fo:static-content><fo:flow flow-name="xsl-region-body" font-size="10pt" line-height="12pt"><fo:block>a1</fo:block><fo:block>a2</fo:block><fo:block>a3</fo:block><fo:block>a4</fo:block><fo:block>a5</fo:block><fo:block>a6</fo:block><fo:block>a7</fo:block><fo:block>a8</fo:block><fo:block>a9</fo:block><fo:block>a10</fo:block><fo:block>a11</fo:block><fo:block>a12</fo:block><fo:block>a13</fo:block><fo:block>a14</fo:block><fo:block>a15</fo:block><fo:block>a16</fo:block><fo:block>a17</fo:block><fo:block>a18</fo:block><fo:block>a19</fo:block><fo:block>a20</fo:block></fo:flow></fo:page-sequence>
</fo:root>
  </fo>
  <checks>
    <eval expected="2" xpath="count(//pageViewport)"/>
    <eval expected="10000 244000 280000 36000" xpath="(//pageViewport)[1]//regionViewport[regionAfter]/@rect"/>
    <eval expected="10000 50000 280000 194000" xpath="(//pageViewport)[1]//regionViewport[regionBody]/@rect"/>
    <eval expected="f3" xpath="((//pageViewport)[1]//regionAfter//word)[3]"/>
  </checks>
</testcase>
