    <eval expected="7" xpath="count(//pageViewport)"/>
    <eval expected="A" xpath="(//pageViewport)[1]/@simple-page-master-name"/>
    <eval expected="A" xpath="(//pageViewport)[2]/@simple-page-master-name"/>
