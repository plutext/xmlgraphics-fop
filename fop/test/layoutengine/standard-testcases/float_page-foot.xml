  <checks>
    <eval expected="18" xpath="count(//pageViewport)"/>
    <!-- 1: the last line ends at 299pt, within the body: it stays beside the float -->
    <eval expected="1" xpath="count((//pageViewport)[1]//word[.='a7'])"/>
    <eval expected="1" xpath="count((//pageViewport)[2]//word[.='a-after'])"/>
    <!-- 2: it would end at 303pt: it opens the next page, at the full width. Before, it stayed, past the body's foot -->
    <eval expected="1" xpath="count((//pageViewport)[3]//word[.='b6'])"/>
    <eval expected="0" xpath="count((//pageViewport)[3]//word[.='b7'])"/>
    <eval expected="1" xpath="count((//pageViewport)[4]//word[.='b7'])"/>
    <eval expected="400000" xpath="//word[.='b7']/ancestor::lineArea[1]/@ipd"/>
    <!-- 3: the same with no float -->
    <eval expected="1" xpath="count((//pageViewport)[5]//word[.='c6'])"/>
    <eval expected="1" xpath="count((//pageViewport)[6]//word[.='c7'])"/>
    <!-- 4: the moved line's space-before is discarded at the page's top: this edge is a page break -->
    <eval expected="1" xpath="count((//pageViewport)[8]//word[.='d7'])"/>
    <eval expected="0" xpath="count(//word[.='d7']/ancestor::block[1]/@space-before)"/>
    <!-- 5: the first line after the start edge goes too, and nothing is beside the float -->
    <eval expected="0" xpath="count((//pageViewport)[9]//word[.='e-first'])"/>
    <eval expected="1" xpath="count((//pageViewport)[10]//word[.='e-first'])"/>
    <eval expected="400000" xpath="//word[.='e-first']/ancestor::lineArea[1]/@ipd"/>
    <!-- 6: fits below its own 6pt space-before: it stays beside the float -->
    <eval expected="1" xpath="count((//pageViewport)[11]//word[.='f-first'])"/>
    <eval expected="300000" xpath="//word[.='f-first']/ancestor::lineArea[1]/@ipd"/>
    <!-- 7: fits below the space-after above it: the same -->
    <eval expected="1" xpath="count((//pageViewport)[13]//word[.='g-first'])"/>
    <eval expected="300000" xpath="//word[.='g-first']/ancestor::lineArea[1]/@ipd"/>
    <!-- 8: fits after an end edge: it stays, at the full width, and keeps its space-before -->
    <eval expected="1" xpath="count((//pageViewport)[15]//word[.='h6'])"/>
    <eval expected="400000" xpath="//word[.='h6']/ancestor::lineArea[1]/@ipd"/>
    <eval expected="6000" xpath="//word[.='h6']/ancestor::block[1]/@space-before"/>
    <!-- 9: crosses the foot only by its border: the border's glue lies past the auxiliary box -->
    <eval expected="0" xpath="count((//pageViewport)[17]//word[.='i-first'])"/>
    <eval expected="1" xpath="count((//pageViewport)[18]//word[.='i-first'])"/>
  </checks>
</testcase>
