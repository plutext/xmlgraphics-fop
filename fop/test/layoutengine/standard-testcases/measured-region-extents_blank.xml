<!-- Added by Plutext Pty Ltd for the docx4j FO renderer (docx4j-fo-renderer), a modified distribution derived
     from Apache FOP 2.11: a test of hook measured-region-extents (fop/CR-018). -->
<testcase>
  <info>
    <p>
      A blank page added by force-page-count="even", whose master has a measured header of its own: the blank page
      takes that header's height (five lines), the content pages theirs (three).
    </p>
  </info>
  <fo>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:fox="http://xmlgraphics.apache.org/fop/extensions">
<fo:layout-master-set><fo:simple-page-master master-name="M" page-width="300pt" page-height="300pt" margin-top="20pt" margin-bottom="20pt" margin-left="10pt" margin-right="10pt"><fo:region-body margin-top="30pt" margin-bottom="30pt"/><fo:region-before extent="10pt" region-name="xsl-region-before" fox:extent="measured"/><fo:region-after extent="10pt" region-name="xsl-region-after" fox:extent="measured"/></fo:simple-page-master><fo:simple-page-master master-name="Blank" page-width="300pt" page-height="300pt" margin-top="20pt" margin-bottom="20pt" margin-left="10pt" margin-right="10pt"><fo:region-body margin-top="30pt" margin-bottom="30pt"/><fo:region-before extent="10pt" region-name="blank-before" fox:extent="measured"/><fo:region-after extent="10pt" region-name="xsl-region-after" fox:extent="measured"/></fo:simple-page-master><fo:page-sequence-master master-name="P"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="Blank" blank-or-not-blank="blank"/><fo:conditional-page-master-reference master-reference="M"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master></fo:layout-master-set>
<fo:page-sequence master-reference="P" force-page-count="even"><fo:static-content flow-name="xsl-region-before" font-size="10pt" line-height="12pt"><fo:block>h1</fo:block><fo:block>h2</fo:block><fo:block>h3</fo:block></fo:static-content><fo:static-content flow-name="blank-before" font-size="10pt" line-height="12pt"><fo:block>b1</fo:block><fo:block>b2</fo:block><fo:block>b3</fo:block><fo:block>b4</fo:block><fo:block>b5</fo:block></fo:static-content><fo:flow flow-name="xsl-region-body" font-size="10pt" line-height="12pt"><fo:block>a1</fo:block><fo:block>a2</fo:block><fo:block>a3</fo:block><fo:block>a4</fo:block><fo:block>a5</fo:block><fo:block>a6</fo:block><fo:block>a7</fo:block><fo:block>a8</fo:block><fo:block>a9</fo:block><fo:block>a10</fo:block><fo:block>a11</fo:block><fo:block>a12</fo:block><fo:block>a13</fo:block><fo:block>a14</fo:block><fo:block>a15</fo:block><fo:block>a16</fo:block><fo:block>a17</fo:block><fo:block>a18</fo:block><fo:block>a19</fo:block><fo:block>a20</fo:block><fo:block>a21</fo:block><fo:block>a22</fo:block><fo:block>a23</fo:block><fo:block>a24</fo:block><fo:block>a25</fo:block><fo:block>a26</fo:block><fo:block>a27</fo:block><fo:block>a28</fo:block><fo:block>a29</fo:block><fo:block>a30</fo:block><fo:block>a31</fo:block><fo:block>a32</fo:block><fo:block>a33</fo:block><fo:block>a34</fo:block><fo:block>a35</fo:block><fo:block>a36</fo:block><fo:block>a37</fo:block><fo:block>a38</fo:block><fo:block>a39</fo:block><fo:block>a40</fo:block></fo:flow></fo:page-sequence>
</fo:root>
  </fo>
  <checks>
    <eval expected="4" xpath="count(//pageViewport)"/>
    <eval expected="Blank" xpath="(//pageViewport)[4]/@simple-page-master-name"/>
    <eval expected="10000 20000 280000 60000" xpath="(//pageViewport)[4]//regionViewport[regionBefore]/@rect"/>
    <eval expected="10000 80000 280000 170000" xpath="(//pageViewport)[4]//regionViewport[regionBody]/@rect"/>
    <eval expected="10000 20000 280000 36000" xpath="(//pageViewport)[1]//regionViewport[regionBefore]/@rect"/>
  </checks>
</testcase>
