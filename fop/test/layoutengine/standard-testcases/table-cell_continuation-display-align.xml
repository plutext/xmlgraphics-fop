<!-- $Id$ -->
<testcase>
  <info>
    <p>
      This test checks fox:continuation-display-align on fo:table-cell, the display-align of a cell's
      parts after the first when the cell is broken across pages. Both cells are display-align="after"
      and both break: the first one line on each page, the second one line, then two. Without the
      extension (first page-sequence) the first cell's one-line continuation is aligned to the after
      edge, below an empty space; with it set to "before" (second page-sequence) the continuation
      starts at the top, as a word processor sets it. The parts on the first page are unchanged.
    </p>
  </info>
  <fo>
    <fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:fox="http://xmlgraphics.apache.org/fop/extensions">
      <fo:layout-master-set>
        <fo:simple-page-master master-name="page" page-width="300pt" page-height="120pt" margin="10pt">
          <fo:region-body/>
        </fo:simple-page-master>
      </fo:layout-master-set>
      <fo:page-sequence master-reference="page">
        <fo:flow flow-name="xsl-region-body" font-size="10pt" line-height="12pt">
          <fo:block>a</fo:block><fo:block>b</fo:block><fo:block>c</fo:block><fo:block>d</fo:block><fo:block>e</fo:block><fo:block>f</fo:block><fo:block>g</fo:block>
          <fo:table table-layout="fixed" width="280pt">
            <fo:table-column column-width="140pt"/>
            <fo:table-column column-width="140pt"/>
            <fo:table-body>
              <fo:table-row>
                <fo:table-cell display-align="after"><fo:block>one</fo:block><fo:block>two</fo:block></fo:table-cell>
                <fo:table-cell display-align="after"><fo:block>x1</fo:block><fo:block>x2</fo:block><fo:block>x3</fo:block></fo:table-cell>
              </fo:table-row>
            </fo:table-body>
          </fo:table>
        </fo:flow>
      </fo:page-sequence>
      <fo:page-sequence master-reference="page">
        <fo:flow flow-name="xsl-region-body" font-size="10pt" line-height="12pt">
          <fo:block>a</fo:block><fo:block>b</fo:block><fo:block>c</fo:block><fo:block>d</fo:block><fo:block>e</fo:block><fo:block>f</fo:block><fo:block>g</fo:block>
          <fo:table table-layout="fixed" width="280pt">
            <fo:table-column column-width="140pt"/>
            <fo:table-column column-width="140pt"/>
            <fo:table-body>
              <fo:table-row>
                <fo:table-cell display-align="after" fox:continuation-display-align="before"><fo:block>one</fo:block><fo:block>two</fo:block></fo:table-cell>
                <fo:table-cell display-align="after" fox:continuation-display-align="before"><fo:block>x1</fo:block><fo:block>x2</fo:block><fo:block>x3</fo:block></fo:table-cell>
              </fo:table-row>
            </fo:table-body>
          </fo:table>
        </fo:flow>
      </fo:page-sequence>
    </fo:root>
  </fo>
  <checks>
    <eval expected="4" xpath="count(//pageViewport)"/>
    <!-- without the extension: the continuation is after-aligned, below an empty block -->
    <eval expected="0" xpath="count((//pageViewport)[2]//flow/block/block[1]/block[1]/*)"/>
    <eval expected="12000" xpath="(//pageViewport)[2]//flow/block/block[1]/block[1]/@bpd"/>
    <eval expected="two" xpath="(//pageViewport)[2]//flow/block/block[1]/block[2]/lineArea"/>
    <!-- with it: the continuation starts at the top -->
    <eval expected="two" xpath="(//pageViewport)[4]//flow/block/block[1]/block[1]/lineArea"/>
    <eval expected="1" xpath="count((//pageViewport)[4]//flow/block/block[1]/block)"/>
    <!-- the first parts are the same either way -->
    <eval expected="one" xpath="(//pageViewport)[1]//flow/block[last()]/block[1]/block[last()]/lineArea"/>
    <eval expected="one" xpath="(//pageViewport)[3]//flow/block[last()]/block[1]/block[last()]/lineArea"/>
  </checks>
</testcase>
