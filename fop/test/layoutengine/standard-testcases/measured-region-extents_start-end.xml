<!-- Added by Plutext Pty Ltd for the docx4j FO renderer (docx4j-fo-renderer), a modified distribution derived
     from Apache FOP 2.11: a test of hook measured-region-extents (fop/CR-018). -->
<testcase>
  <info>
    <p>
      Region-start and region-end beside a measured region-before (three lines, 36pt) and region-after (one line,
      12pt). First sequence: before and after have precedence, so the sides lie between them and move with the
      measured extents, 26pt down from the top and 2pt up from the foot. Second: no precedence, so the sides keep
      the page's full height and before and after are narrowed by them, as FOP lays them out.
    </p>
  </info>
  <fo>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:fox="http://xmlgraphics.apache.org/fop/extensions">
<fo:layout-master-set><fo:simple-page-master master-name="P" page-width="300pt" page-height="300pt" margin-top="20pt" margin-bottom="20pt" margin-left="10pt" margin-right="10pt"><fo:region-body margin-top="30pt" margin-bottom="30pt" margin-left="40pt" margin-right="40pt"/><fo:region-before extent="10pt" precedence="true" fox:extent="measured"/><fo:region-after extent="10pt" precedence="true" fox:extent="measured"/><fo:region-start extent="30pt"/><fo:region-end extent="30pt"/></fo:simple-page-master><fo:simple-page-master master-name="Q" page-width="300pt" page-height="300pt" margin-top="20pt" margin-bottom="20pt" margin-left="10pt" margin-right="10pt"><fo:region-body margin-top="30pt" margin-bottom="30pt" margin-left="40pt" margin-right="40pt"/><fo:region-before extent="10pt" fox:extent="measured"/><fo:region-after extent="10pt" fox:extent="measured"/><fo:region-start extent="30pt"/><fo:region-end extent="30pt"/></fo:simple-page-master></fo:layout-master-set>
<fo:page-sequence master-reference="P"><fo:static-content flow-name="xsl-region-before" font-size="10pt" line-height="12pt"><fo:block>h1</fo:block><fo:block>h2</fo:block><fo:block>h3</fo:block></fo:static-content><fo:static-content flow-name="xsl-region-after" font-size="10pt" line-height="12pt"><fo:block>f1</fo:block></fo:static-content><fo:static-content flow-name="xsl-region-start" font-size="10pt" line-height="12pt"><fo:block>s</fo:block></fo:static-content><fo:flow flow-name="xsl-region-body" font-size="10pt" line-height="12pt"><fo:block>a1</fo:block><fo:block>a2</fo:block><fo:block>a3</fo:block><fo:block>a4</fo:block><fo:block>a5</fo:block></fo:flow></fo:page-sequence>
<fo:page-sequence master-reference="Q"><fo:static-content flow-name="xsl-region-before" font-size="10pt" line-height="12pt"><fo:block>h1</fo:block><fo:block>h2</fo:block><fo:block>h3</fo:block></fo:static-content><fo:static-content flow-name="xsl-region-after" font-size="10pt" line-height="12pt"><fo:block>f1</fo:block></fo:static-content><fo:static-content flow-name="xsl-region-start" font-size="10pt" line-height="12pt"><fo:block>s</fo:block></fo:static-content><fo:flow flow-name="xsl-region-body" font-size="10pt" line-height="12pt"><fo:block>b1</fo:block><fo:block>b2</fo:block><fo:block>b3</fo:block><fo:block>b4</fo:block><fo:block>b5</fo:block></fo:flow></fo:page-sequence>
</fo:root>
  </fo>
  <checks>
    <eval expected="2" xpath="count(//pageViewport)"/>
    <eval expected="10000 20000 280000 36000" xpath="(//pageViewport)[1]//regionViewport[regionBefore]/@rect"/>
    <eval expected="10000 268000 280000 12000" xpath="(//pageViewport)[1]//regionViewport[regionAfter]/@rect"/>
    <eval expected="10000 56000 30000 212000" xpath="(//pageViewport)[1]//regionViewport[regionStart]/@rect"/>
    <eval expected="260000 56000 30000 212000" xpath="(//pageViewport)[1]//regionViewport[regionEnd]/@rect"/>
    <eval expected="50000 56000 200000 194000" xpath="(//pageViewport)[1]//regionViewport[regionBody]/@rect"/>
    <eval expected="s" xpath="((//pageViewport)[1]//regionStart//word)[1]"/>
    <eval expected="40000 20000 220000 36000" xpath="(//pageViewport)[2]//regionViewport[regionBefore]/@rect"/>
    <eval expected="40000 268000 220000 12000" xpath="(//pageViewport)[2]//regionViewport[regionAfter]/@rect"/>
    <eval expected="10000 20000 30000 260000" xpath="(//pageViewport)[2]//regionViewport[regionStart]/@rect"/>
    <eval expected="260000 20000 30000 260000" xpath="(//pageViewport)[2]//regionViewport[regionEnd]/@rect"/>
    <eval expected="50000 56000 200000 194000" xpath="(//pageViewport)[2]//regionViewport[regionBody]/@rect"/>
  </checks>
</testcase>
