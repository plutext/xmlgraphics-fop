<!-- Added by Plutext Pty Ltd for the docx4j FO renderer (docx4j-fo-renderer), a modified distribution derived
     from Apache FOP 2.11: a test of hook measured-region-extents (fop/CR-018). -->
<testcase>
  <info>
    <p>
      A header with an absolutely positioned block-container 80pt tall (a floating drawing) and a page number:
      the block-container takes no height, as in a real layout, so the header measures one line.
    </p>
  </info>
  <fo>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:fox="http://xmlgraphics.apache.org/fop/extensions">
<fo:layout-master-set><fo:simple-page-master master-name="M" page-width="300pt" page-height="300pt" margin-top="20pt" margin-bottom="20pt" margin-left="10pt" margin-right="10pt"><fo:region-body margin-top="30pt" margin-bottom="30pt"/><fo:region-before extent="10pt" region-name="xsl-region-before" fox:extent="measured"/><fo:region-after extent="10pt" region-name="xsl-region-after" fox:extent="measured"/></fo:simple-page-master></fo:layout-master-set>
<fo:page-sequence master-reference="M"><fo:static-content flow-name="xsl-region-before" font-size="10pt" line-height="12pt"><fo:block-container absolute-position="absolute" top="0pt" left="0pt" width="20pt" height="80pt"><fo:block>abs</fo:block></fo:block-container><fo:block>Page <fo:page-number/></fo:block></fo:static-content><fo:flow flow-name="xsl-region-body" font-size="10pt" line-height="12pt"><fo:block>a1</fo:block><fo:block>a2</fo:block><fo:block>a3</fo:block><fo:block>a4</fo:block><fo:block>a5</fo:block><fo:block>a6</fo:block><fo:block>a7</fo:block><fo:block>a8</fo:block><fo:block>a9</fo:block><fo:block>a10</fo:block><fo:block>a11</fo:block><fo:block>a12</fo:block><fo:block>a13</fo:block><fo:block>a14</fo:block><fo:block>a15</fo:block><fo:block>a16</fo:block><fo:block>a17</fo:block><fo:block>a18</fo:block><fo:block>a19</fo:block><fo:block>a20</fo:block></fo:flow></fo:page-sequence>
</fo:root>
  </fo>
  <checks>
    <eval expected="10000 20000 280000 12000" xpath="(//pageViewport)[1]//regionViewport[regionBefore]/@rect"/>
    <eval expected="10000 50000 280000 200000" xpath="(//pageViewport)[1]//regionViewport[regionBody]/@rect"/>
  </checks>
</testcase>
