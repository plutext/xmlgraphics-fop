<!-- Added by Plutext Pty Ltd for the docx4j FO renderer (docx4j-fo-renderer), a modified distribution derived
     from Apache FOP 2.11: a test of hook page-master-by-content (fop/CR-017). -->
<testcase>
  <info>
    <p>
      A part whose page-sequence-master has alternatives with page-position="last" (Bl) and "only" (Bo) beside
      the general one (B): those two are reported by an event and ignored, and the part takes B for every page it
      owns, the last included.
    </p>
  </info>
  <fo>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:fox="http://xmlgraphics.apache.org/fop/extensions"><fo:layout-master-set><fo:simple-page-master master-name="A" page-width="300pt" page-height="200pt" margin-top="10pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body/></fo:simple-page-master><fo:simple-page-master master-name="B" page-width="300pt" page-height="200pt" margin-top="40pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body/></fo:simple-page-master><fo:simple-page-master master-name="Bl" page-width="300pt" page-height="200pt" margin-top="70pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body/></fo:simple-page-master><fo:simple-page-master master-name="Bo" page-width="300pt" page-height="200pt" margin-top="90pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body/></fo:simple-page-master><fo:page-sequence-master master-name="psmA"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="A"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master><fo:page-sequence-master master-name="psmL"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="Bo" page-position="only"/><fo:conditional-page-master-reference master-reference="Bl" page-position="last"/><fo:conditional-page-master-reference master-reference="B"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master></fo:layout-master-set>
<fo:page-sequence master-reference="psmA"><fo:flow flow-name="xsl-region-body" font-size="10pt" line-height="12pt"><fo:block fox:page-sequence-master-reference="psmA"><fo:block>a1</fo:block><fo:block>a2</fo:block><fo:block>a3</fo:block><fo:block>a4</fo:block><fo:block>a5</fo:block><fo:block>a6</fo:block><fo:block>a7</fo:block><fo:block>a8</fo:block><fo:block>a9</fo:block><fo:block>a10</fo:block><fo:block>a11</fo:block><fo:block>a12</fo:block><fo:block>a13</fo:block><fo:block>a14</fo:block><fo:block>a15</fo:block></fo:block><fo:block fox:page-sequence-master-reference="psmL" break-before="page"><fo:block>b1</fo:block><fo:block>b2</fo:block><fo:block>b3</fo:block><fo:block>b4</fo:block><fo:block>b5</fo:block><fo:block>b6</fo:block><fo:block>b7</fo:block><fo:block>b8</fo:block><fo:block>b9</fo:block><fo:block>b10</fo:block><fo:block>b11</fo:block><fo:block>b12</fo:block><fo:block>b13</fo:block><fo:block>b14</fo:block><fo:block>b15</fo:block><fo:block>b16</fo:block><fo:block>b17</fo:block><fo:block>b18</fo:block><fo:block>b19</fo:block><fo:block>b20</fo:block></fo:block></fo:flow></fo:page-sequence>
</fo:root>
  </fo>
  <checks>
    <eval expected="3" xpath="count(//pageViewport)"/>
    <eval expected="A" xpath="(//pageViewport)[1]/@simple-page-master-name"/>
    <eval expected="B" xpath="(//pageViewport)[2]/@simple-page-master-name"/>
    <eval expected="B" xpath="(//pageViewport)[3]/@simple-page-master-name"/>
  </checks>
  <event-checks>
    <event key="pageMasterReferenceLastOrOnlyIgnored" psmName="psmL"/>
  </event-checks>
</testcase>
