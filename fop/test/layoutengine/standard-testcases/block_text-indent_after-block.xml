<!-- Added by Plutext Pty Ltd for the docx4j FO renderer (docx4j-fo-renderer), a modified distribution derived from
     Apache FOP 2.11: first-line-indent-after-block (fop/CR-035). See README.md, "Changes from Apache FOP 2.11". -->
<testcase>
  <info>
    <p>
      This test checks that text-indent is applied to a block's first line whatever block-level children precede
      its inline content (fop/CR-035): a zero-height block-container holding an absolutely positioned box (how a
      word processor's anchored text box or picture is written), and an empty block. Apache FOP indented only when
      the inline content was the block's first child. A nested block after inline content still takes no indent
      from the enclosing block (block_text-indent.xml's third case), and a nested block's own first line keeps the
      inherited indent.
    </p>
  </info>
  <fo>
    <fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
      <fo:layout-master-set>
        <fo:simple-page-master master-name="normal" page-width="5in" page-height="5in">
          <fo:region-body/>
        </fo:simple-page-master>
      </fo:layout-master-set>
      <fo:page-sequence master-reference="normal" white-space-collapse="true">
        <fo:flow flow-name="xsl-region-body" font-family="Helvetica" font-size="10pt">
          <!-- 1: control, a hanging indent with inline content only -->
          <fo:block start-indent="21.3pt" text-indent="-21.3pt" space-after="12pt">H1 control: hanging first line, then enough text to wrap onto a second line at the start-indent of the block here.</fo:block>
          <!-- 2: the same led by a zero-height block-container holding an absolutely positioned box -->
          <fo:block start-indent="21.3pt" text-indent="-21.3pt" space-after="12pt"><fo:block-container height="0pt" start-indent="0pt"><fo:block-container absolute-position="absolute" top="0pt" left="300pt" width="30pt" height="12pt"><fo:block text-indent="0pt">X</fo:block></fo:block-container></fo:block-container>H2 led: hanging first line, then enough text to wrap onto a second line at the start-indent of the block here.</fo:block>
          <!-- 3: control, a first-line indent with inline content only -->
          <fo:block start-indent="3pt" text-indent="18pt" space-after="12pt">P1 control: first-line indent, then enough text to wrap onto a second line at the start-indent of the block here.</fo:block>
          <!-- 4: the same led by an empty block -->
          <fo:block start-indent="3pt" text-indent="18pt" space-after="12pt"><fo:block/>P2 led: first-line indent, then enough text to wrap onto a second line at the start-indent of the block here.</fo:block>
          <!-- 5: led by a nested block with content of its own: that block's first line inherits the indent, and the
               enclosing block's first line, after it, takes the indent too -->
          <fo:block start-indent="3pt" text-indent="18pt" space-after="12pt"><fo:block>N1 nested first.</fo:block>P3 led: first-line indent, then enough text to wrap onto a second line at the start-indent of the block here.</fo:block>
          <!-- 6: inline content, then a nested block, then inline content: the second run takes no indent -->
          <fo:block start-indent="3pt" text-indent="18pt">P4 first run.<fo:block>N2 nested.</fo:block>P4 second run, after the nested block, takes no indent.</fo:block>
        </fo:flow>
      </fo:page-sequence>
    </fo:root>
  </fo>
  <checks>
    <!-- 1: control -->
    <eval expected="-21300" xpath="//flow/block[1]/lineArea[1]/@start-indent"/>
    <true xpath="not(//flow/block[1]/lineArea[2]/@start-indent)"/>
    <!-- 2: the hanging indent is kept after the zero-height block-container -->
    <eval expected="-21300" xpath="//flow/block[2]/lineArea[1]/@start-indent"/>
    <true xpath="not(//flow/block[2]/lineArea[2]/@start-indent)"/>
    <eval expected="H2" xpath="//flow/block[2]/lineArea[1]//word[1]"/>
    <!-- 3: control -->
    <eval expected="18000" xpath="//flow/block[3]/lineArea[1]/@start-indent"/>
    <true xpath="not(//flow/block[3]/lineArea[2]/@start-indent)"/>
    <!-- 4: the first-line indent is kept after the empty block -->
    <eval expected="18000" xpath="//flow/block[4]/lineArea[1]/@start-indent"/>
    <true xpath="not(//flow/block[4]/lineArea[2]/@start-indent)"/>
    <eval expected="P2" xpath="//flow/block[4]/lineArea[1]//word[1]"/>
    <!-- 5: the nested block's own first line inherits the indent; the enclosing block's first line takes it -->
    <eval expected="18000" xpath="//flow/block[5]/block[1]/lineArea[1]/@start-indent"/>
    <eval expected="18000" xpath="//flow/block[5]/lineArea[1]/@start-indent"/>
    <eval expected="P3" xpath="//flow/block[5]/lineArea[1]//word[1]"/>
    <true xpath="not(//flow/block[5]/lineArea[2]/@start-indent)"/>
    <!-- 6: as Apache's block_text-indent.xml: the run after the nested block is not indented -->
    <eval expected="18000" xpath="//flow/block[6]/lineArea[1]/@start-indent"/>
    <eval expected="18000" xpath="//flow/block[6]/block[1]/lineArea[1]/@start-indent"/>
    <true xpath="not(//flow/block[6]/lineArea[2]/@start-indent)"/>
    <eval expected="P4" xpath="//flow/block[6]/lineArea[2]//word[1]"/>
  </checks>
</testcase>
