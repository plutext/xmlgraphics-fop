<!-- Added by Plutext Pty Ltd for the docx4j FO renderer (docx4j-fo-renderer), a modified distribution derived
     from Apache FOP 2.11: a test of hook page-master-by-content (fop/CR-017). -->
<testcase>
  <info>
    <p>
      Blank pages take the owner of the page before them and that owner's blank master (Cb, 100pt top margin):
      the blank page force-page-count="even" adds (first sequence), and the blank before a
      break-before="odd-page" (second sequence).
    </p>
  </info>
  <fo>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:fox="http://xmlgraphics.apache.org/fop/extensions">
<fo:layout-master-set><fo:simple-page-master master-name="A" page-width="300pt" page-height="200pt" margin-top="10pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body column-count="1" column-gap="10pt"/></fo:simple-page-master><fo:simple-page-master master-name="B" page-width="300pt" page-height="200pt" margin-top="40pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body column-count="1" column-gap="10pt"/></fo:simple-page-master><fo:simple-page-master master-name="Bf" page-width="300pt" page-height="200pt" margin-top="60pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body column-count="1" column-gap="10pt"/></fo:simple-page-master><fo:simple-page-master master-name="Co" page-width="300pt" page-height="200pt" margin-top="40pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body column-count="1" column-gap="10pt"/></fo:simple-page-master><fo:simple-page-master master-name="Ce" page-width="300pt" page-height="200pt" margin-top="70pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body column-count="1" column-gap="10pt"/></fo:simple-page-master><fo:simple-page-master master-name="Cb" page-width="300pt" page-height="200pt" margin-top="100pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body column-count="1" column-gap="10pt"/></fo:simple-page-master><fo:page-sequence-master master-name="psmA"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="A"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master><fo:page-sequence-master master-name="psmB"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="Bf" page-position="first"/><fo:conditional-page-master-reference master-reference="B"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master><fo:page-sequence-master master-name="psmC"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="Cb" blank-or-not-blank="blank"/><fo:conditional-page-master-reference master-reference="Co" odd-or-even="odd"/><fo:conditional-page-master-reference master-reference="Ce" odd-or-even="even"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master></fo:layout-master-set>
<fo:page-sequence master-reference="psmA" force-page-count="even"><fo:flow flow-name="xsl-region-body" font-size="10pt" line-height="12pt"><fo:block fox:page-sequence-master-reference="psmA"><fo:block>a1</fo:block><fo:block>a2</fo:block><fo:block>a3</fo:block><fo:block>a4</fo:block><fo:block>a5</fo:block><fo:block>a6</fo:block><fo:block>a7</fo:block><fo:block>a8</fo:block><fo:block>a9</fo:block><fo:block>a10</fo:block><fo:block>a11</fo:block><fo:block>a12</fo:block><fo:block>a13</fo:block><fo:block>a14</fo:block><fo:block>a15</fo:block><fo:block>a16</fo:block><fo:block>a17</fo:block><fo:block>a18</fo:block><fo:block>a19</fo:block><fo:block>a20</fo:block></fo:block><fo:block fox:page-sequence-master-reference="psmC"><fo:block>c1</fo:block><fo:block>c2</fo:block><fo:block>c3</fo:block><fo:block>c4</fo:block><fo:block>c5</fo:block><fo:block>c6</fo:block><fo:block>c7</fo:block><fo:block>c8</fo:block><fo:block>c9</fo:block><fo:block>c10</fo:block><fo:block>c11</fo:block><fo:block>c12</fo:block></fo:block></fo:flow></fo:page-sequence>
<fo:page-sequence master-reference="psmA"><fo:flow flow-name="xsl-region-body" font-size="10pt" line-height="12pt"><fo:block fox:page-sequence-master-reference="psmA"><fo:block>a1</fo:block><fo:block>a2</fo:block><fo:block>a3</fo:block><fo:block>a4</fo:block><fo:block>a5</fo:block><fo:block>a6</fo:block><fo:block>a7</fo:block><fo:block>a8</fo:block><fo:block>a9</fo:block><fo:block>a10</fo:block><fo:block>a11</fo:block><fo:block>a12</fo:block><fo:block>a13</fo:block><fo:block>a14</fo:block><fo:block>a15</fo:block><fo:block>a16</fo:block><fo:block>a17</fo:block><fo:block>a18</fo:block><fo:block>a19</fo:block><fo:block>a20</fo:block></fo:block><fo:block fox:page-sequence-master-reference="psmC"><fo:block>d1</fo:block><fo:block>d2</fo:block><fo:block>d3</fo:block><fo:block>d4</fo:block><fo:block>d5</fo:block><fo:block>d6</fo:block><fo:block>d7</fo:block><fo:block>d8</fo:block><fo:block>d9</fo:block><fo:block>d10</fo:block><fo:block>d11</fo:block><fo:block>d12</fo:block><fo:block>d13</fo:block><fo:block>d14</fo:block><fo:block>d15</fo:block><fo:block>d16</fo:block><fo:block>d17</fo:block><fo:block>d18</fo:block><fo:block break-before="odd-page">d-odd</fo:block><fo:block>d20</fo:block><fo:block>d21</fo:block><fo:block>d22</fo:block><fo:block>d23</fo:block><fo:block>d24</fo:block></fo:block></fo:flow></fo:page-sequence>
</fo:root>
  </fo>
  <checks>
    <eval expected="9" xpath="count(//pageViewport)"/>
    <eval expected="A" xpath="(//pageViewport)[1]/@simple-page-master-name"/>
    <eval expected="A" xpath="(//pageViewport)[2]/@simple-page-master-name"/>
    <eval expected="Co" xpath="(//pageViewport)[3]/@simple-page-master-name"/>
    <eval expected="Cb" xpath="(//pageViewport)[4]/@simple-page-master-name"/>
    <eval expected="A" xpath="(//pageViewport)[5]/@simple-page-master-name"/>
    <eval expected="A" xpath="(//pageViewport)[6]/@simple-page-master-name"/>
    <eval expected="Co" xpath="(//pageViewport)[7]/@simple-page-master-name"/>
    <eval expected="Cb" xpath="(//pageViewport)[8]/@simple-page-master-name"/>
    <eval expected="Co" xpath="(//pageViewport)[9]/@simple-page-master-name"/>
    <eval expected="0" xpath="count((//pageViewport)[4]//word)"/>
    <eval expected="0" xpath="count((//pageViewport)[8]//word)"/>
    <eval expected="d-odd" xpath="((//pageViewport)[9]//word)[1]"/>
  </checks>
</testcase>
