<testcase>
  <info>
    <p>
      Column balancing beyond the first page of an element list: a two-column part runs from page 1 to page 4,
      where a span="all" block makes FOP balance the columns. The balanced page is the part's, with its master's
      height.
    </p>
  </info>
  <fo>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:fox="http://xmlgraphics.apache.org/fop/extensions">
<fo:layout-master-set><fo:simple-page-master master-name="A2" page-width="300pt" page-height="200pt" margin-top="10pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body column-count="2" column-gap="10pt"/></fo:simple-page-master><fo:simple-page-master master-name="B2" page-width="300pt" page-height="200pt" margin-top="40pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body column-count="2" column-gap="10pt"/></fo:simple-page-master><fo:page-sequence-master master-name="psmA2"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="A2"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master><fo:page-sequence-master master-name="psmB2"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="B2"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master></fo:layout-master-set>
