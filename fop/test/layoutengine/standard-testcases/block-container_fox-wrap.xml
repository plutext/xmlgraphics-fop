    <eval expected="7" xpath="count((//pageViewport)[1]//lineArea[not(ancestor::block[@positioning='fixed' or @positioning='absolute'])][@ipd='301000'])"/>
    <eval expected="451000" xpath="((//pageViewport)[1]//lineArea[not(ancestor::block[@positioning='fixed' or @positioning='absolute'])])[12]/@ipd"/>
    <eval expected="0" xpath="count((//pageViewport)[1]//lineArea[not(ancestor::block[@positioning='fixed' or @positioning='absolute'])][@ipd!='301000' and @ipd!='451000'])"/>
    <!-- 2: left only: the lines beside the container 150pt wide -->
    <eval expected="150000" xpath="((//pageViewport)[2]//lineArea[not(ancestor::block[@positioning='fixed' or @positioning='absolute'])])[5]/@ipd"/>
    <eval expected="7" xpath="count((//pageViewport)[2]//lineArea[not(ancestor::block[@positioning='fixed' or @positioning='absolute'])][@ipd='150000'])"/>
    <!-- 3: largest side, the container at the left margin: the lines 301pt wide -->
    <eval expected="301000" xpath="((//pageViewport)[3]//lineArea[not(ancestor::block[@positioning='fixed' or @positioning='absolute'])])[5]/@ipd"/>
    <eval expected="7" xpath="count((//pageViewport)[3]//lineArea[not(ancestor::block[@positioning='fixed' or @positioning='absolute'])][@ipd='301000'])"/>
    <!-- 4: top-and-bottom: no line beside it, the content after the fourth line set 100pt down at its foot -->
    <eval expected="0" xpath="count((//pageViewport)[4]//lineArea[not(ancestor::block[@positioning='fixed' or @positioning='absolute'])][@ipd &lt; 451000])"/>
    <eval expected="1" xpath="count((//pageViewport)[4]//flow/block[@bpd='100000' and not(@positioning)])"/>
    <!-- 5: distances 12 18 24 6: the band is 52 to 182 in the flow, so the lines from 48 to 192 are beside it, 277pt wide -->
    <eval expected="451000" xpath="((//pageViewport)[5]//lineArea[not(ancestor::block[@positioning='fixed' or @positioning='absolute'])])[3]/@ipd"/>
    <eval expected="277000" xpath="((//pageViewport)[5]//lineArea[not(ancestor::block[@positioning='fixed' or @positioning='absolute'])])[4]/@ipd"/>
    <eval expected="9" xpath="count((//pageViewport)[5]//lineArea[not(ancestor::block[@positioning='fixed' or @positioning='absolute'])][@ipd='277000'])"/>
    <!-- 6: absolute, 32pt below its paragraph's top: the band from 48, the fourth line of the page the first beside it -->
    <eval expected="451000" xpath="//word[.='f0']/ancestor::lineArea[1]/@ipd"/>
    <eval expected="451000" xpath="((//pageViewport)[6]//lineArea[not(ancestor::block[@positioning='fixed' or @positioning='absolute'])])[3]/@ipd"/>
    <eval expected="301000" xpath="((//pageViewport)[6]//lineArea[not(ancestor::block[@positioning='fixed' or @positioning='absolute'])])[4]/@ipd"/>
    <!-- 7: the control: every line full width -->
    <eval expected="0" xpath="count((//pageViewport)[7]//lineArea[not(ancestor::block[@positioning='fixed' or @positioning='absolute'])][@ipd &lt; 451000])"/>
  </checks>
