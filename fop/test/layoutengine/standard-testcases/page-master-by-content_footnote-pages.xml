<testcase>
  <info>
    <p>
      The second part starts part-way down page 2 with a footnote too long for the page, and the content ends
      there. The pages holding only the rest of the footnote take the owner of the page before them (A), not
      the part in force at the end of the content (B).
    </p>
  </info>
  <fo>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:fox="http://xmlgraphics.apache.org/fop/extensions">
<fo:layout-master-set><fo:simple-page-master master-name="A" page-width="300pt" page-height="200pt" margin-top="10pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body column-count="1" column-gap="10pt"/></fo:simple-page-master><fo:simple-page-master master-name="B" page-width="300pt" page-height="200pt" margin-top="40pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body column-count="1" column-gap="10pt"/></fo:simple-page-master><fo:simple-page-master master-name="Bf" page-width="300pt" page-height="200pt" margin-top="60pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body column-count="1" column-gap="10pt"/></fo:simple-page-master><fo:simple-page-master master-name="Co" page-width="300pt" page-height="200pt" margin-top="40pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body column-count="1" column-gap="10pt"/></fo:simple-page-master><fo:simple-page-master master-name="Ce" page-width="300pt" page-height="200pt" margin-top="70pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body column-count="1" column-gap="10pt"/></fo:simple-page-master><fo:simple-page-master master-name="Cb" page-width="300pt" page-height="200pt" margin-top="100pt" margin-bottom="10pt" margin-left="10pt" margin-right="10pt"><fo:region-body column-count="1" column-gap="10pt"/></fo:simple-page-master><fo:page-sequence-master master-name="psmA"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="A"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master><fo:page-sequence-master master-name="psmB"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="Bf" page-position="first"/><fo:conditional-page-master-reference master-reference="B"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master><fo:page-sequence-master master-name="psmC"><fo:repeatable-page-master-alter