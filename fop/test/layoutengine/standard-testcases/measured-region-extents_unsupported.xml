<!-- Added by Plutext Pty Ltd for the docx4j FO renderer (docx4j-fo-renderer), a modified distribution derived
     from Apache FOP 2.11: a test of hook measured-region-extents (fop/CR-018). -->
<testcase>
  <info>
    <p>
      fox:extent="measured" on a master at reference-orientation 90, which the measurement does not support: an
      event reports it, raised before the measurement mutes events, and the region keeps its stated extent (10pt)
      where its static content is three lines.
    </p>
  </info>
  <fo>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:fox="http://xmlgraphics.apache.org/fop/extensions"><fo:layout-master-set><fo:simple-page-master master-name="R" page-width="300pt" page-height="300pt" margin="20pt" reference-orientation="90"><fo:region-body margin-top="30pt"/><fo:region-before extent="10pt" fox:extent="measured"/></fo:simple-page-master></fo:layout-master-set>
<fo:page-sequence master-reference="R"><fo:static-content flow-name="xsl-region-before" font-size="10pt" line-height="12pt"><fo:block>h1</fo:block><fo:block>h2</fo:block><fo:block>h3</fo:block></fo:static-content><fo:flow flow-name="xsl-region-body" font-size="10pt" line-height="12pt"><fo:block>a1</fo:block><fo:block>a2</fo:block><fo:block>a3</fo:block><fo:block>a4</fo:block><fo:block>a5</fo:block></fo:flow></fo:page-sequence>
</fo:root>
  </fo>
  <checks>
    <eval expected="1" xpath="count(//pageViewport)"/>
    <eval expected="10000" xpath="//regionViewport/regionBefore/@bpd"/>
  </checks>
  <event-checks>
    <event key="measuredExtentUnsupported" masterName="R"/>
  </event-checks>
</testcase>
