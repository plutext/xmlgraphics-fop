<?xml version="1.0" encoding="UTF-8"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
  <fo:layout-master-set>
    <fo:simple-page-master master-name="A4" page-height="29.7cm" page-width="21cm" margin="2cm">
      <fo:region-body/>
    </fo:simple-page-master>
  </fo:layout-master-set>
  <fo:page-sequence master-reference="A4">
    <fo:flow flow-name="xsl-region-body" font-size="24pt" font-style="italic" font-weight="bold">
      <fo:block font-family="ItalFace">Italic face</fo:block>
      <fo:block font-family="RegFace">Regular face</fo:block>
      <fo:block font-family="BoldFace">Bold face</fo:block>
    </fo:flow>
  </fo:page-sequence>
</fo:root>
