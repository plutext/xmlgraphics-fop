<?xml version="1.0"?>
<!-- Run from the root of an xmlgraphics-fop checkout: the fonts are the ones in its test tree. -->
<fop version="1.0">
  <font-base>fop/test/resources/fonts/ttf/</font-base>
  <renderers>
    <renderer mime="application/pdf">
      <fonts>
        <font embed-url="Aegean600.ttf"><font-triplet name="Aegean600" style="normal" weight="normal"/></font>
        <font embed-url="DejaVuLGCSerif.ttf"><font-triplet name="DejaVuLGCSerif" style="normal" weight="normal"/></font>
      </fonts>
    </renderer>
  </renderers>
</fop>
